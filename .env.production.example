# Copy to /opt/portfolio/.env on the EC2 host. Never commit the real file.

AWS_REGION=ap-south-1
FRONTEND_ORIGIN=https://www.rezaul.dev

POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=portfolio
DATABASE_URL=postgresql://portfolio:replace-with-a-long-random-password@postgres:5432/portfolio?schema=public
REDIS_URL=redis://redis:6379

S3_UPLOADS_BUCKET=portfolio-uploads-accountid

# Docker Hub: username/portfolio-backend
# GHCR: ghcr.io/swe-rezaul-karim/portfolio-backend
DOCKER_IMAGE=swe-rezaul-karim/portfolio-backend
DOCKER_REGISTRY=
DOCKER_USERNAME=
DOCKER_PASSWORD=

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=true

ADMIN_BOOTSTRAP_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://www.rezaul.dev/api/v1/auth/google/callback

IMAGE_TAG=latest
