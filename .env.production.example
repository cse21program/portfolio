# Copy to /opt/portfolio/.env on the EC2 host. Never commit the real file.

AWS_REGION=ap-south-1
FRONTEND_ORIGIN=https://www.rezaulkarim.dev

POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=portfolio
DATABASE_URL=postgresql://portfolio:replace-with-a-long-random-password@postgres:5432/portfolio?schema=public
REDIS_URL=redis://redis:6379

S3_UPLOADS_BUCKET=portfolio-uploads-accountid

# Docker Hub: username/portfolio-backend
# GHCR: ghcr.io/swe-rezaul-karim/portfolio-backend
DOCKER_IMAGE=rezaul1998/portfolio-backend
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=rezaul1998
DOCKER_PASSWORD=

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=true

# Must match the Google or password email you sign in with. If this was empty
# when you first signed in, set it, restart the API, then sign in again.
ADMIN_BOOTSTRAP_EMAIL=cse21program@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be the public CloudFront site, not api.rezaulkarim.dev. The SPA calls /api
# on www, so Google has to return there or the sign-in cookies never come back.
# Also add this exact URI in Google Cloud Console → Authorized redirect URIs.
GOOGLE_CALLBACK_URL=https://www.rezaulkarim.dev/api/v1/auth/google/callback

IMAGE_TAG=latest
