NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

DATABASE_URL=postgresql://portfolio:portfolio@localhost:5433/portfolio?schema=public

CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Set true only when the site is served over HTTPS
# COOKIE_SECURE=false

# The first sign-in (or a later sign-in) with this email becomes ADMIN.
# ADMIN_BOOTSTRAP_EMAIL=you@example.com

# Google OAuth (optional). In Google Cloud Console:
# Authorized JavaScript origins: http://localhost:5173 and https://rezaulkarim.dev
# Authorized redirect URIs:
#   http://localhost:5173/api/v1/auth/google/callback
#   https://rezaulkarim.dev/api/v1/auth/google/callback
# Do not use https://api.rezaulkarim.dev for the redirect URI. The site talks to
# /api on the same host, and a different callback host drops the sign-in cookies.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:5173/api/v1/auth/google/callback

# Optional. Production EC2 compose sets redis://redis:6379
# REDIS_URL=redis://127.0.0.1:6379
# Local media uploads go to backend/uploads. In production, set
# S3_UPLOADS_BUCKET to the Terraform uploads_bucket output. The API
# uses the EC2 instance role; do not put AWS keys here.
# UPLOAD_DIR=/var/lib/portfolio/uploads
# S3_UPLOADS_BUCKET=
# AWS_REGION=ap-south-1
