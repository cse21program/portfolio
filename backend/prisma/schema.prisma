generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String?
  googleId        String?    @unique
  name            String?
  imageUrl        String?
  phone           String     @default("")
  country         String     @default("")
  notifyProduct   Boolean    @default(true)
  notifyMarketing Boolean    @default(false)
  role            Role       @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  emailVerified   Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  refreshTokens RefreshToken[]
  authTokens    AuthToken[]
  blogComments  BlogComment[]
  blogLikes     BlogLike[]
  blogBookmarks BlogBookmark[]
  enrollments      Enrollment[]
  serviceOrders    ServiceOrder[]
  contactMessages  ContactMessage[]
  cart             Cart?
  orders           Order[]
  payments         Payment[]
  reviews          Review[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Profile {
  id                 String   @id @default("default")
  fullName           String
  professionalTitle  String
  shortBiography     String
  detailedBiography  String[]
  careerObjectives   String
  philosophy         String
  interests          String[]
  location           String
  yearsOfExperience  String
  languages          String[]
  availability       String
  profilePhotoUrl    String
  coverImageUrl      String?
  gallery            Json     @default("[]")
  introVideoUrl      String?
  embedVideoUrl      String?
  links              Json
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("profiles")
}

model Resume {
  id           String   @id @default("default")
  headline     String?
  summary      String?
  awards       Json     @default("[]")
  publications Json     @default("[]")
  pdfUrl       String?
  pdfFileName  String?
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("resumes")
}

model Experience {
  id               String   @id @default(uuid())
  company          String
  position         String
  employmentType   String
  location         String   @default("")
  startDate        String
  endDate          String   @default("")
  current          Boolean  @default(false)
  description      String   @default("")
  responsibilities String[] @default([])
  achievements     String[] @default([])
  technologies     String[] @default([])
  logoUrl          String?
  website          String?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sortOrder])
  @@map("experiences")
}

model Education {
  id           String   @id @default(uuid())
  institution  String
  degree       String
  field        String
  startDate    String
  endDate      String   @default("")
  current      Boolean  @default(false)
  grade        String   @default("")
  location     String   @default("")
  description  String   @default("")
  achievements String[] @default([])
  logoUrl      String?
  documentUrl  String?
  documentName String?
  website      String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sortOrder])
  @@map("education")
}

model Certificate {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  organization     String
  issueDate        String   @default("")
  expiryDate       String   @default("")
  credentialId     String   @default("")
  skill            String   @default("")
  description      String   @default("")
  imageUrl         String?
  documentUrl      String?
  documentName     String?
  verificationUrl  String?
  featured         Boolean  @default(false)
  status           String   @default("published")
  publishedAt      String   @default("")
  seoTitle         String   @default("")
  seoDescription   String   @default("")
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sortOrder])
  @@index([status])
  @@index([featured])
  @@map("certificates")
}

model Project {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  shortDescription String
  fullDescription  String   @default("")
  thumbnailUrl     String?
  images           String[] @default([])
  demoVideoUrl     String?
  category         String   @default("")
  technologies     String[] @default([])
  features         String[] @default([])
  architecture     String   @default("")
  problem          String   @default("")
  requirements     String   @default("")
  solution         String   @default("")
  challenges       String[] @default([])
  solutions        String[] @default([])
  lessons          String[] @default([])
  status           String   @default("Shipped")
  startDate        String   @default("")
  endDate          String   @default("")
  githubUrl        String?
  liveUrl          String?
  docsUrl          String?
  featured         Boolean  @default(false)
  published        Boolean  @default(true)
  seoTitle         String   @default("")
  seoDescription   String   @default("")
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sortOrder])
  @@index([featured])
  @@index([published])
  @@map("projects")
}

model Field {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  summary        String
  overview       String   @default("")
  iconUrl        String?
  thumbnailUrl   String?
  bannerUrl      String?
  videoUrl       String?
  embedVideoUrl  String?
  featured       Boolean  @default(false)
  published      Boolean  @default(true)
  seoTitle       String   @default("")
  seoDescription String   @default("")
  sortOrder      Int      @default(0)
  skills         Skill[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sortOrder])
  @@index([featured])
  @@map("fields")
}

model Skill {
  id             String       @id @default(uuid())
  name           String
  slug           String       @unique
  fieldId        String
  field          Field        @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  level          String
  years          String       @default("")
  summary        String
  overview       String       @default("")
  iconUrl        String?
  imageUrl       String?
  videoUrl       String?
  embedVideoUrl  String?
  featured       Boolean      @default(false)
  published      Boolean      @default(true)
  seoTitle       String       @default("")
  seoDescription String       @default("")
  sortOrder      Int          @default(0)
  topics         Topic[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([sortOrder])
  @@index([fieldId])
  @@index([featured])
  @@map("skills")
}

model Topic {
  id                      String   @id @default(uuid())
  skillId                 String
  skill                   Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  title                   String
  slug                    String
  summary                 String
  overview                String   @default("")
  body                    String   @default("")
  images                  String[] @default([])
  videoUrl                String?
  embedVideoUrl           String?
  codeSnippets            Json     @default("[]")
  resources               Json     @default("[]")
  externalLinks           Json     @default("[]")
  relatedBlogSlugs        String[] @default([])
  relatedTutorialSlugs    String[] @default([])
  relatedCourseSlugs      String[] @default([])
  relatedProjectSlugs     String[] @default([])
  relatedCertificateSlugs String[] @default([])
  published               Boolean  @default(true)
  seoTitle                String   @default("")
  seoDescription          String   @default("")
  sortOrder               Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([skillId, slug])
  @@index([skillId, sortOrder])
  @@index([published])
  @@map("topics")
}

model Blog {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  excerpt          String
  content          String[] @default([])
  featuredImageUrl String?
  author           String   @default("")
  category         String   @default("")
  tags             String[] @default([])
  skill            String   @default("")
  topic            String   @default("")
  readingTime      String   @default("")
  publishedAt      String   @default("")
  status           String   @default("published")
  seoTitle         String   @default("")
  seoDescription   String   @default("")
  canonicalUrl     String   @default("")
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sortOrder])
  @@index([status])
  @@index([category])
  @@map("blogs")
}

model BlogComment {
  id        String   @id @default(uuid())
  slug      String
  userId    String
  body      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([slug, createdAt])
  @@map("blog_comments")
}

model BlogLike {
  id        String   @id @default(uuid())
  slug      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([slug, userId])
  @@index([slug])
  @@map("blog_likes")
}

model BlogBookmark {
  id        String   @id @default(uuid())
  slug      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([slug, userId])
  @@index([userId, createdAt])
  @@map("blog_bookmarks")
}

model NewsletterSubscriber {
  id               String   @id @default(uuid())
  email            String   @unique
  name             String   @default("")
  unsubscribeToken String   @unique
  createdAt        DateTime @default(now())

  @@map("newsletter_subscribers")
}

model Tutorial {
  id                 String   @id @default(uuid())
  title              String
  slug               String   @unique
  description        String
  difficulty         String   @default("Beginner")
  prerequisites      String[] @default([])
  duration           String   @default("")
  thumbnailUrl       String?
  skill              String   @default("")
  relatedSkillSlugs  String[] @default([])
  relatedCourseSlugs String[] @default([])
  price              String   @default("Free")
  free               Boolean  @default(true)
  sections           Json     @default("[]")
  status             String   @default("published")
  publishedAt        String   @default("")
  seoTitle           String   @default("")
  seoDescription     String   @default("")
  canonicalUrl       String   @default("")
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([sortOrder])
  @@index([status])
  @@index([difficulty])
  @@map("tutorials")
}

model Course {
  id                    String   @id @default(uuid())
  title                 String
  slug                  String   @unique
  subtitle              String   @default("")
  description           String
  overview              String[] @default([])
  thumbnailUrl          String?
  promoVideoUrl         String?
  instructor            String   @default("Rezaul Karim")
  category              String   @default("")
  skill                 String   @default("")
  difficulty            String   @default("Beginner")
  language              String   @default("English")
  duration              String   @default("")
  requirements          String[] @default([])
  outcomes              String[] @default([])
  audience              String[] @default([])
  price                 String   @default("Free")
  salePrice             String   @default("")
  currency              String   @default("USD")
  free                  Boolean  @default(false)
  featured              Boolean  @default(false)
  certificateAvailable  Boolean  @default(false)
  relatedSkillSlugs     String[] @default([])
  relatedTutorialSlugs  String[] @default([])
  relatedCourseSlugs    String[] @default([])
  modules               Json     @default("[]")
  status                String   @default("published")
  publishedAt           String   @default("")
  seoTitle              String   @default("")
  seoDescription        String   @default("")
  canonicalUrl          String   @default("")
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([sortOrder])
  @@index([status])
  @@index([difficulty])
  @@index([featured])
  @@map("courses")
}

model Enrollment {
  id              String           @id @default(uuid())
  userId          String
  courseSlug      String
  courseTitle     String
  status          String           @default("active")
  source          String           @default("self")
  grantedByUserId String?
  enrolledAt      DateTime         @default(now())
  canceledAt      DateTime?
  lastActivityAt  DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonProgress  LessonProgress[]
  certificate     CourseCertificate?

  @@unique([userId, courseSlug])
  @@index([userId, status])
  @@index([courseSlug])
  @@index([status])
  @@map("enrollments")
}

model LessonProgress {
  id           String     @id @default(uuid())
  enrollmentId String
  lessonKey    String
  completedAt  DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonKey])
  @@index([enrollmentId])
  @@map("lesson_progress")
}

model CourseCertificate {
  id             String     @id @default(uuid())
  publicId       String     @unique
  enrollmentId   String     @unique
  userId         String
  courseSlug     String
  courseTitle    String
  instructor     String
  recipientName  String
  recipientEmail String
  issuedAt       DateTime   @default(now())
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseSlug])
  @@map("course_certificates")
}

model Service {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  shortDescription String
  description      String
  thumbnailUrl     String?
  category         String   @default("")
  startingPrice    String   @default("")
  pricingType      String   @default("Starting from")
  deliveryTime     String   @default("")
  features         String[] @default([])
  requirements     String[] @default([])
  technologies     String[] @default([])
  faq              Json     @default("[]")
  packages         Json     @default("[]")
  available        Boolean  @default(true)
  featured         Boolean  @default(false)
  status           String   @default("published")
  publishedAt      String   @default("")
  seoTitle         String   @default("")
  seoDescription   String   @default("")
  canonicalUrl     String   @default("")
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sortOrder])
  @@index([status])
  @@index([featured])
  @@index([available])
  @@map("services")
}

model ServiceOrder {
  id           String    @id @default(uuid())
  userId       String
  serviceSlug  String
  serviceTitle String
  packageName  String    @default("")
  requirements String
  budget       String    @default("")
  timeline     String    @default("")
  status       String    @default("pending")
  adminNote    String    @default("")
  source       String    @default("self")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  canceledAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([serviceSlug])
  @@index([status])
  @@map("service_orders")
}

model ContactMessage {
  id            String    @id @default(uuid())
  name          String
  email         String
  phone         String    @default("")
  company       String    @default("")
  subject       String
  serviceSlug   String    @default("")
  serviceTitle  String    @default("")
  budget        String    @default("")
  message       String
  attachmentUrl String?
  status        String    @default("new")
  adminNote     String    @default("")
  userId        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  readAt        DateTime?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
  @@map("contact_messages")
}

model Coupon {
  id         String   @id @default(uuid())
  code       String   @unique
  percentOff Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("coupons")
}

model Cart {
  id         String     @id @default(uuid())
  userId     String     @unique
  couponCode String     @default("")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@map("carts")
}

model CartItem {
  id           String   @id @default(uuid())
  cartId       String
  kind         String
  slug         String
  title        String
  packageName  String   @default("")
  href         String
  thumbnailUrl String?
  unitLabel    String
  unitCents    Int
  currency     String   @default("USD")
  quantity     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cart         Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, kind, slug, packageName])
  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id               String      @id @default(uuid())
  orderNumber      String      @unique
  userId           String
  status           String      @default("pending_payment")
  subtotalCents    Int
  discountCents    Int         @default(0)
  taxCents         Int         @default(0)
  totalCents       Int
  currency         String      @default("USD")
  couponCode       String      @default("")
  couponPercentOff Int?
  billingName      String
  billingEmail     String
  billingPhone     String      @default("")
  country          String
  address          String
  city             String
  postal           String
  paymentMethod    String
  termsAccepted    Boolean
  adminNote        String      @default("")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  canceledAt       DateTime?
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            OrderItem[]
  payments         Payment[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  kind         String
  slug         String
  title        String
  packageName  String   @default("")
  href         String
  thumbnailUrl String?
  unitLabel    String
  unitCents    Int
  currency     String   @default("USD")
  quantity     Int      @default(1)
  lineCents    Int
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id            String    @id @default(uuid())
  userId        String
  orderId       String
  provider      String
  transactionId String    @unique
  amountCents   Int
  currency      String    @default("USD")
  method        String
  status        String    @default("pending")
  paidAt        DateTime?
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([userId])
  @@index([status])
  @@map("payments")
}

model PaymentProviderSetting {
  provider    String   @id
  enabled     Boolean  @default(true)
  mode        String   @default("demo")
  credentials String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("payment_provider_settings")
}

model Review {
  id          String    @id @default(uuid())
  userId      String
  kind        String
  slug        String
  title       String
  href        String    @default("")
  rating      Int
  comment     String
  status      String    @default("pending")
  verified    Boolean   @default(true)
  adminNote   String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, slug])
  @@index([kind, slug, status])
  @@index([userId, createdAt])
  @@index([status])
  @@map("reviews")
}

model MediaAsset {
  id           String   @id @default(uuid())
  filename     String   @unique
  originalName String
  kind         String
  contentType  String
  sizeBytes    Int
  url          String
  alt          String   @default("")
  caption      String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([kind, createdAt])
  @@index([createdAt])
  @@map("media_assets")
}

model VideoAsset {
  id        String   @id @default(uuid())
  title     String
  provider  String
  url       String   @unique
  embedUrl  String?
  posterUrl String?
  caption   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider, createdAt])
  @@index([createdAt])
  @@map("video_assets")
}

model SiteVisit {
  id         String   @id @default(uuid())
  visitorKey String
  path       String
  createdAt  DateTime @default(now())

  @@index([visitorKey, createdAt])
  @@index([path, createdAt])
  @@index([createdAt])
  @@map("site_visits")
}

model SiteAccess {
  id        String   @id @default("site")
  catalogs  Json
  updatedAt DateTime @updatedAt

  @@map("site_access")
}
