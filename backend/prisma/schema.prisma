generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String?
  googleId      String?    @unique
  name          String?
  role          Role       @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  refreshTokens RefreshToken[]
  authTokens    AuthToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Profile {
  id                 String   @id @default("default")
  fullName           String
  professionalTitle  String
  shortBiography     String
  detailedBiography  String[]
  careerObjectives   String
  philosophy         String
  interests          String[]
  location           String
  yearsOfExperience  String
  languages          String[]
  availability       String
  profilePhotoUrl    String
  coverImageUrl      String?
  gallery            Json     @default("[]")
  introVideoUrl      String?
  embedVideoUrl      String?
  links              Json
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("profiles")
}

model Resume {
  id           String   @id @default("default")
  headline     String?
  summary      String?
  awards       Json     @default("[]")
  publications Json     @default("[]")
  pdfUrl       String?
  pdfFileName  String?
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("resumes")
}

model Experience {
  id               String   @id @default(uuid())
  company          String
  position         String
  employmentType   String
  location         String   @default("")
  startDate        String
  endDate          String   @default("")
  current          Boolean  @default(false)
  description      String   @default("")
  responsibilities String[] @default([])
  achievements     String[] @default([])
  technologies     String[] @default([])
  logoUrl          String?
  website          String?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sortOrder])
  @@map("experiences")
}

model Education {
  id           String   @id @default(uuid())
  institution  String
  degree       String
  field        String
  startDate    String
  endDate      String   @default("")
  current      Boolean  @default(false)
  grade        String   @default("")
  location     String   @default("")
  description  String   @default("")
  achievements String[] @default([])
  logoUrl      String?
  documentUrl  String?
  documentName String?
  website      String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sortOrder])
  @@map("education")
}

model Project {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  shortDescription String
  fullDescription  String   @default("")
  thumbnailUrl     String?
  images           String[] @default([])
  demoVideoUrl     String?
  category         String   @default("")
  technologies     String[] @default([])
  features         String[] @default([])
  architecture     String   @default("")
  problem          String   @default("")
  requirements     String   @default("")
  solution         String   @default("")
  challenges       String[] @default([])
  solutions        String[] @default([])
  lessons          String[] @default([])
  status           String   @default("Shipped")
  startDate        String   @default("")
  endDate          String   @default("")
  githubUrl        String?
  liveUrl          String?
  docsUrl          String?
  featured         Boolean  @default(false)
  seoTitle         String   @default("")
  seoDescription   String   @default("")
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sortOrder])
  @@index([featured])
  @@map("projects")
}

model Field {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  summary        String
  overview       String   @default("")
  iconUrl        String?
  thumbnailUrl   String?
  bannerUrl      String?
  videoUrl       String?
  embedVideoUrl  String?
  featured       Boolean  @default(false)
  published      Boolean  @default(true)
  seoTitle       String   @default("")
  seoDescription String   @default("")
  sortOrder      Int      @default(0)
  skills         Skill[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sortOrder])
  @@index([featured])
  @@map("fields")
}

model Skill {
  id             String       @id @default(uuid())
  name           String
  slug           String       @unique
  fieldId        String
  field          Field        @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  level          String
  years          String       @default("")
  summary        String
  overview       String       @default("")
  iconUrl        String?
  imageUrl       String?
  videoUrl       String?
  embedVideoUrl  String?
  featured       Boolean      @default(false)
  published      Boolean      @default(true)
  seoTitle       String       @default("")
  seoDescription String       @default("")
  sortOrder      Int          @default(0)
  topics         SkillTopic[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([sortOrder])
  @@index([fieldId])
  @@index([featured])
  @@map("skills")
}

model SkillTopic {
  id                   String   @id @default(uuid())
  skillId              String
  skill                Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  title                String
  slug                 String
  summary              String
  overview             String   @default("")
  images               String[] @default([])
  videoUrl             String?
  embedVideoUrl        String?
  relatedBlogSlugs     String[] @default([])
  relatedTutorialSlugs String[] @default([])
  relatedCourseSlugs   String[] @default([])
  seoTitle             String   @default("")
  seoDescription       String   @default("")
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([skillId, slug])
  @@index([skillId, sortOrder])
  @@map("skill_topics")
}
